-- MAIN GUI
local function mainGUI()

	keyFrame:Destroy()

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0,360,0,250)
	frame.Position = UDim2.new(.5,-180,.5,-125)
	frame.BackgroundColor3 = Color3.fromRGB(8,8,18)
	frame.Parent = gui
	corner(frame,22)

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 5
	stroke.Parent = frame

	-- RAINBOW GLOW
	task.spawn(function()
		while frame.Parent do
			for h=0,1,.01 do
				stroke.Color = Color3.fromHSV(h,1,1)
				task.wait(.02)
			end
		end
	end)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1,-60,0,55)
	title.Position = UDim2.new(0,20,0,12)
	title.BackgroundTransparency = 1
	title.Text = "🌈 100x LUCKY SERVER"
	title.TextColor3 = Color3.new(1,1,1)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBlack
	title.Parent = frame

	-- CLOSE
	local close = Instance.new("TextButton")
	close.Size = UDim2.new(0,38,0,38)
	close.Position = UDim2.new(1,-48,0,10)
	close.BackgroundColor3 = Color3.fromRGB(220,45,70)
	close.Text = "×"
	close.TextColor3 = Color3.new(1,1,1)
	close.TextScaled = true
	close.Font = Enum.Font.GothamBlack
	close.Parent = frame
	corner(close,10)

	close.MouseButton1Click:Connect(function()
		gui:Destroy()
	end)

	local desc = Instance.new("TextLabel")
	desc.Size = UDim2.new(1,-30,0,40)
	desc.Position = UDim2.new(0,15,0,65)
	desc.BackgroundTransparency = 1
	desc.Text = "⚡ Find another server!"
	desc.TextColor3 = Color3.fromRGB(190,190,210)
	desc.TextScaled = true
	desc.Font = Enum.Font.Gotham
	desc.Parent = frame

	-- SERVER HOP
	local hop = Instance.new("TextButton")
	hop.Size = UDim2.new(1,-40,0,55)
	hop.Position = UDim2.new(0,20,0,115)
	hop.BackgroundColor3 = Color3.fromRGB(85,55,255)
	hop.Text = "🚀 SERVER HOP"
	hop.TextColor3 = Color3.new(1,1,1)
	hop.TextScaled = true
	hop.Font = Enum.Font.GothamBlack
	hop.Parent = frame
	corner(hop,14)

	hop.MouseButton1Click:Connect(function()

		hop.Text = "🌌 SERVER HOPPING..."

		tween(hop,.15,{
			Size = UDim2.new(1,-50,0,50)
		})

		task.wait(.4)

		-- Teleport to another instance
		local success, err = pcall(function()
			TeleportService:Teleport(game.PlaceId, player)
		end)

		if not success then
			hop.Text = "❌ TELEPORT FAILED"
			warn(err)

			task.wait(2)
			hop.Text = "🚀 SERVER HOP"
			hop.Active = true
		end
	end)

	local footer = Instance.new("TextLabel")
	footer.Size = UDim2.new(1,-30,0,30)
	footer.Position = UDim2.new(0,15,0,190)
	footer.BackgroundTransparency = 1
	footer.Text = "🔐 Secured • 📱 Mobile Supported"
	footer.TextColor3 = Color3.fromRGB(130,130,160)
	footer.TextScaled = true
	footer.Font = Enum.Font.Gotham
	footer.Parent = frame

	-- DRAG
	local dragging = false
	local dragStart
	local startPos

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then

			local delta = input.Position - dragStart

			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	-- POPUP ANIMATION
	frame.Size = UDim2.new(0,0,0,0)

	tween(frame,.6,{
		Size = UDim2.new(0,360,0,250)
	})
end

-- KEY CHECK
unlock.MouseButton1Click:Connect(function()

	if keyBox.Text == "🔐" then

		info.Text = "✅ Key accepted!"
		info.TextColor3 = Color3.fromRGB(80,255,140)

		task.wait(.6)
		mainGUI()

	else

		info.Text = "❌ Invalid key!"
		info.TextColor3 = Color3.fromRGB(255,80,100)

		keyBox.Text = ""
	end
end)
