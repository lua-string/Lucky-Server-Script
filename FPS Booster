-- =========================
-- MOVABLE FPS OVERLAY
-- =========================

local draggingFPS = false
local dragStartFPS
local startPosFPS

FPSOverlay.InputBegan:Connect(function(input)

    if fpsLocked then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        draggingFPS = true
        dragStartFPS = input.Position
        startPosFPS = FPSOverlay.Position

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if draggingFPS and not fpsLocked then

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStartFPS

            FPSOverlay.Position = UDim2.new(
                startPosFPS.X.Scale,
                startPosFPS.X.Offset + delta.X,
                startPosFPS.Y.Scale,
                startPosFPS.Y.Offset + delta.Y
            )

        end

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        draggingFPS = false

    end

end)

-- =========================
-- FPS COUNTER
-- =========================

RunService.RenderStepped:Connect(function()

    frames += 1

    local now = os.clock()

    if now - lastTime >= 0.5 then

        fps = math.floor(frames / (now - lastTime))
        frames = 0
        lastTime = now

        FPSLabel.Text = "FPS: " .. tostring(fps)

        if fps >= 50 then

            FPSLabel.TextColor3 = Green
            FPSOverlay.TextColor3 = Green

        elseif fps >= 30 then

            FPSLabel.TextColor3 = Yellow
            FPSOverlay.TextColor3 = Yellow

        else

            FPSLabel.TextColor3 = Red
            FPSOverlay.TextColor3 = Red

        end

        if fpsLocked then
            FPSOverlay.Text = "FPS: " .. tostring(fps) .. " 🔒"
        else
            FPSOverlay.Text = "FPS: " .. tostring(fps)
        end

    end

end)

