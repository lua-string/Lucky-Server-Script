-- =========================
-- TOGGLE FUNCTION
-- =========================

local function makeToggle(text, y, default, callback)

    local holder = new("Frame", {
        Size = UDim2.new(1, -30, 0, 48),
        Position = UDim2.fromOffset(15, y),
        BackgroundColor3 = Color3.fromRGB(27, 13, 45),
        BorderSizePixel = 0
    }, Main)

    corner(holder, 12)

    new("TextLabel", {
        Size = UDim2.new(1, -95, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = White,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    }, holder)

    local button = new("TextButton", {
        Size = UDim2.fromOffset(65, 30),
        Position = UDim2.new(1, -75, 0.5, -15),
        BackgroundColor3 = default and Purple
            or Color3.fromRGB(65, 50, 75),
        Text = default and "ON" or "OFF",
        TextColor3 = White,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        AutoButtonColor = false
    }, holder)

    corner(button, 10)

    local state = default

    button.MouseButton1Click:Connect(function()

        state = not state

        tween(button, 0.2, {
            BackgroundColor3 = state and Purple
                or Color3.fromRGB(65, 50, 75)
        })

        button.Text = state and "ON" or "OFF"

        callback(state)

    end)

    return holder
end

