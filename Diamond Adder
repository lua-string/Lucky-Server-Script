-- FIND DIAMONDCOUNT
local function GetDiamondCount()
	return PlayerGui:FindFirstChild("DiamondCount", true)
end

-- CHANGE DISPLAYED TEXT ONLY
local function AddVisualDiamonds(Amount)
	local DiamondCount = GetDiamondCount()

	if not DiamondCount then
		return false
	end

	local TextObject

	if DiamondCount:IsA("TextLabel")
		or DiamondCount:IsA("TextButton")
		or DiamondCount:IsA("TextBox") then

		TextObject = DiamondCount
	else
		TextObject =
			DiamondCount:FindFirstChildWhichIsA("TextLabel", true)
			or DiamondCount:FindFirstChildWhichIsA("TextButton", true)
			or DiamondCount:FindFirstChildWhichIsA("TextBox", true)
	end

	if not TextObject then
		return false
	end

	local CurrentAmount = tonumber(string.match(TextObject.Text, "%d+")) or 0
	local NewAmount = math.clamp(CurrentAmount + Amount, 0, 999999999)

	TextObject.Text = tostring(NewAmount)

	return true
end

-- APPLY BUTTON FUNCTION
Apply.MouseButton1Click:Connect(function()
	local Amount = tonumber(InputBox.Text)

	if not Amount then
		Info.Text = "⚠ Enter a valid number."
		return
	end

	Amount = math.floor(Amount)

	if Amount < 1 or Amount > 9999 then
		Info.Text = "⚠ Enter 1 to 9999 only."
		return
	end

	if AddVisualDiamonds(Amount) then
		Info.Text = "💎 Visually added: +" .. Amount
		InputBox.Text = ""
	else
		Info.Text = "⚠ DiamondCount not found."
	end
end)

